{
  "name": "ssh-desktop",
  "version": "0.1.0",
  "description": "A Windows desktop workspace for SSH connections and terminal sessions.",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --project tsconfig.shared.json && tsc --project tsconfig.node.json && tsc --project tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "npm run typecheck && electron-vite build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7"
  }
}
